# Copy to .env next to docker-compose.yml on the NAS (/mnt/<pool>/docker-compose/coolercontrold/.env).
# Read by docker compose (through the TrueNAS app include) and by the scripts in scripts/.

# Pool mountpoint: data lives in ${APPS_ROOT}/apps-coolercontrold/config.
APPS_ROOT=/mnt/slow

# Address the web UI (port 11987) listens on: the NAS management IP, or 0.0.0.0 for all interfaces.
COOLERCONTROL_BIND=0.0.0.0

# Image tag (optional, defaults to the version pinned in docker-compose.yml).
#COOLERCONTROL_TAG=5.0.1
